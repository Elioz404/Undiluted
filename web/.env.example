# Copy to .env.local and fill in. Values below are the testnet deployment.
PORT=8080
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_NETWORK=testnet

# Who relays. "key" signs with RELAY_PRIVATE_KEY; "near-cli" uses the key the
# local `near` tool keeps in the system keychain, for running on your machine.
RELAY_ACCOUNT=undiluted-dev.testnet
RELAY_SIGNER=key
RELAY_PRIVATE_KEY=
NEAR_CLI=near

OUTLAYER_CONTRACT=outlayer.testnet
ENCLAVE_PROJECT=undiluted-dev.testnet/undiluted
SECRETS_ACCOUNT=undiluted-dev.testnet
SECRETS_PROFILE=default

ANCHOR_CONTRACT=anchor.undiluted-dev.testnet
DISTRIBUTION_CONTRACT=distribution.undiluted-dev.testnet
TREASURY_ACCOUNT=treasury.undiluted-dev.testnet

PAYMENT_API=https://www.usetidepool.tech
ORIGIN_ASSET=nep141:usdt.tidepool-sandbox.testnet
DESTINATION_ASSET=nep141:usdc.tidepool-sandbox.testnet

# What the relay will spend from its own test balance, in micro units.
MAX_PAYMENT_MICROS=5000000
MAX_EXIT_MICROS=10000000

# Keeps a public relay from being drained: all spending in one day, and how
# often one address may call.
DAILY_BUDGET_MICROS=60000000
CALLS_PER_MINUTE=30
SPENDING_CALLS_PER_HOUR=10

# Read by the browser build. The site pins the enclave's signing key and reads
# heads and keys from NEAR itself, not through the relay.
VITE_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
VITE_ANCHOR_CONTRACT=anchor.undiluted-dev.testnet
VITE_ENCLAVE_SIGNING_KEY=
