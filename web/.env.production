# Public settings the site is built with. Nothing here is secret, and nothing
# secret may ever be added: every value ends up in the published page.
#
# The site trusts exactly this enclave: the signing key it pins, the wasm the
# enclave's attestation must name, and OutLayer's register contract that holds
# Intel's collateral and the approved worker images. It reads heads from NEAR
# directly, through this RPC.
VITE_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
VITE_ANCHOR_CONTRACT=anchor.undiluted-dev.testnet
VITE_ENCLAVE_SIGNING_KEY=4385ac1675dfd32bf15f994b0bd1effead92649d12ad7422b7ab003ef97f6ab4
VITE_ENCLAVE_WASM_SHA256=c3b8b92a101e575d1c0e2e502c1fc21443fa0e08e864e84fe467d5840bda9f77
VITE_OUTLAYER_REGISTER_CONTRACT=worker.outlayer.testnet
# Where the relay is. Empty means the site and the relay share an origin; a
# build published apart from the relay sets it, e.g. in CI.
VITE_RELAY_URL=
